{
    "name": "hitch",
    "version": "1.0.0",
    "description": "The map to hitchhiking the world. Read more [here](https://hitchwiki.org/en/Hitchwiki:Maps).",
    "main": "js/map.js",
    "scripts": {
        "test": "node js/e2e.js",
        "build": "esbuild js/map.js --global-name=hitch --bundle --outfile=dist/out.js --external:@capacitor/core",
        "cap:sync": "npm run build && npx cap sync",
        "cap:open:ios": "npx cap open ios",
        "cap:open:android": "npx cap open android",
        "cap:doctor": "npx cap doctor",
        "cap:update": "npx cap update"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bopjesvla/hitch.git"
    },
    "author": "",
    "license": "SEE LICENSE IN LICENSE.md and README",
    "bugs": {
        "url": "https://github.com/bopjesvla/hitch/issues"
    },
    "homepage": "https://github.com/bopjesvla/hitch#readme",
    "dependencies": {
        "@capacitor/android": "^7.0.0",
        "@capacitor/app": "^7.0.0",
        "@capacitor/cli": "^7.0.0",
        "@capacitor/core": "^7.0.0",
        "@capacitor/ios": "^7.0.0",
        "@capacitor/share": "^7.0.2",
        "@capacitor/splash-screen": "^7.0.3",
        "@capawesome/capacitor-android-edge-to-edge-support": "^7.2.3",
        "cordova-background-geolocation-plugin": "^2.3.3",
        "cordova-plugin-device-orientation": "^3.0.0",
        "esbuild": "^0.24.2",
        "playwright": "^1.50.1"
    },
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=9.0.0"
    }
}
